rules_version='2'

service cloud.firestore {
  match /databases/{database}/documents {

    // Admin documents — only readable/writable by the admin themselves
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Candidates — public read, only admins or the owning user can write
    match /candidates/{candidateId} {
      allow read: if true;
      allow create: if request.auth != null && isAdmin(request.auth.uid);
      allow update, delete: if request.auth != null &&
        (isAdmin(request.auth.uid) || resource.data.ownerUid == request.auth.uid);

      // Layouts sub-collection — public read, owner or admin can write
      match /layouts/{layoutId} {
        allow read: if true;
        allow write: if request.auth != null &&
          (isAdmin(request.auth.uid) ||
           get(/databases/$(database)/documents/candidates/$(candidateId)).data.ownerUid == request.auth.uid);
      }
    }

    // Helper function to check if user is admin
    function isAdmin(uid) {
      return exists(/databases/$(database)/documents/admins/$(uid));
    }

    // Deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
